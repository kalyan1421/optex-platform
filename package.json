{
  "name": "optex",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm --filter @optex/web dev",
    "dev:admin": "pnpm --filter @optex/admin dev",
    "dev:api": "pnpm --filter @optex/api dev",
    "prebuild": "pnpm db:types",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:types": "supabase gen types typescript --db-url postgresql://postgres:your-super-secret-and-long-postgres-password@localhost:54322/postgres --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up --build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "typescript": "5.6.3"
  }
}
