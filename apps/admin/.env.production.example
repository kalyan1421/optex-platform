# ──────────────────────────────────────────────────────────────────────────
# OPTEX Admin — PRODUCTION environment variables (Vercel)
# Set in: Vercel Dashboard → Project → Settings → Environment Variables
# Select environment: Production
# NEVER commit a filled-in copy of this file.
# ──────────────────────────────────────────────────────────────────────────

# ── Supabase Cloud ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key_from_dashboard>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_from_dashboard>

# ── OPTEX API ──────────────────────────────────────────────────────────────
# Admin panel routes super_admin actions through the API
NEXT_PUBLIC_API_URL=https://api.optexopticians.co.ke
