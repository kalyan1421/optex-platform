# ──────────────────────────────────────────────────────────────────────────
# OPTEX API — PRODUCTION environment variables
# Set these as secrets in your container host (Fly.io, Railway, ECS, etc.)
# NEVER commit a filled-in copy of this file.
# ──────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=4000

# ── Supabase Cloud ─────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_from_dashboard>
SUPABASE_ANON_KEY=<anon_key_from_dashboard>
# JWT secret: Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=<jwt_secret_from_dashboard>

# ── CORS ───────────────────────────────────────────────────────────────────
# Space/comma-separated list of production frontend origins
CORS_ORIGINS=https://optexopticians.co.ke,https://admin.optexopticians.co.ke

# ── M-Pesa (Daraja) ────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=<safaricom_consumer_key>
MPESA_CONSUMER_SECRET=<safaricom_consumer_secret>
MPESA_SHORTCODE=<till_or_paybill_number>
MPESA_PASSKEY=<lipa_na_mpesa_passkey>
MPESA_CALLBACK_URL=https://api.optexopticians.co.ke/api/webhooks/mpesa

# ── Pesapal ────────────────────────────────────────────────────────────────
PESAPAL_CONSUMER_KEY=<pesapal_consumer_key>
PESAPAL_CONSUMER_SECRET=<pesapal_consumer_secret>
PESAPAL_IPN_URL=https://api.optexopticians.co.ke/api/webhooks/pesapal
PESAPAL_IPN_ID=<ipn_id_from_register_ipn>
PESAPAL_CALLBACK_URL=https://optexopticians.co.ke/order-confirmation

# ── Africa's Talking (SMS) ─────────────────────────────────────────────────
AT_USERNAME=<africastalking_username>
AT_API_KEY=<africastalking_api_key>
AT_SENDER_ID=OPTEX

# ── Resend (email) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_<resend_api_key>
RESEND_FROM=OPTEX Opticians <noreply@optexopticians.co.ke>
CONTACT_INBOX=info@optexopticians.co.ke
