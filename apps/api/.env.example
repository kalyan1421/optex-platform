# ──────────────────────────────────────────────────────────────────────────
# OPTEX API — environment configuration
# Copy to `.env` and fill in. Required vars (no default) fail startup if unset.
#
# LOCAL DOCKER DEV (recommended):
#   docker compose up  → Supabase on :54321, API on :4000
#   Use values below as-is — no changes needed for local dev.
#
# HOSTED SUPABASE (cloud / staging / production):
#   Replace SUPABASE_URL + keys with your cloud project values.
# ──────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# ── Supabase (REQUIRED) ────────────────────────────────────────────────────
# Docker local dev (matches docker-compose.yml defaults — safe to commit):
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7urOIh8bpR79vVmEA4Qrgqp7JFWSteSIWHs
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# When API runs inside Docker itself (api service), use internal name:
# SUPABASE_URL=http://supabase-kong:8000

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Defaults to web (3000) + admin (3001) in dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# M-Pesa (Daraja) — optional until live payments are configured -------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL Daraja POSTs the STK callback to, e.g.
# https://api.optexopticians.com/api/webhooks/mpesa
MPESA_CALLBACK_URL=

# Pesapal — optional until live payments are configured ---------------------
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Public HTTPS URL registered as the IPN listener (RegisterIPN), e.g.
# https://api.optexopticians.com/api/webhooks/pesapal
PESAPAL_IPN_URL=
# IPN id returned by RegisterIPN; required as notification_id on SubmitOrder.
PESAPAL_IPN_ID=
# Browser redirect target after a Pesapal payment completes (falls back to the
# storefront origin when unset).
PESAPAL_CALLBACK_URL=

# Africa's Talking (SMS) — optional until notifications are configured -------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Resend (transactional email) — optional -----------------------------------
RESEND_API_KEY=
# Sender identity, e.g. "Optex <noreply@optexopticians.com>"
RESEND_FROM=
# Destination inbox for contact-form submissions.
CONTACT_INBOX=
