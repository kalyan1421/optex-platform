{
  // Test-only TypeScript config.
  //
  // The app's tsconfig deliberately sets `types: ["node"]` and `include:
  // ["src/**/*"]` so tests never end up in the build output. That also meant
  // ts-jest compiled the e2e spec without Jest's globals, so `describe`, `it`
  // and `expect` were all unresolved. Extending here keeps the build clean and
  // gives the tests the types they need.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "jest"],
    // DOM is added for TESTS ONLY, and only because the contract spec imports
    // `@optex/api-client` — a browser-targeted package whose signatures use
    // `BodyInit`/`Response`/`Blob`. The app's own tsconfig keeps `lib: ES2022`
    // with no DOM on purpose: the API is a Node server and must not compile
    // against browser globals it will not have at runtime.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/**/*"]
}
