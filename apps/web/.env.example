# OPTEX NestJS API origin (no /api suffix). Defaults to localhost:1111 if unset.
NEXT_PUBLIC_API_URL=http://localhost:1111

# Origin the server-side /api/* rewrite proxy forwards to. MUST match wherever
# the API is actually running, or every proxied call fails with ECONNREFUSED:
#   pnpm dev:api  -> http://127.0.0.1:1111  (default, set below)
#   pnpm docker:up -> http://127.0.0.1:4000  (API in the Docker container)
# Uncomment the 4000 line instead if you run the API via Docker (RUNBOOK §1.2).
API_PROXY_ORIGIN=http://127.0.0.1:1111
# API_PROXY_ORIGIN=http://127.0.0.1:4000
