# ──────────────────────────────────────────────────────────────────────────
# OPTEX Web — PRODUCTION environment variables (Vercel)
# Set in: Vercel Dashboard → Project → Settings → Environment Variables
# Select environment: Production  (and Staging/Preview separately)
# NEVER commit a filled-in copy of this file.
# ──────────────────────────────────────────────────────────────────────────

# ── Supabase Cloud ─────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key_from_dashboard>
# Service role — server-side only (Route Handlers, middleware). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_from_dashboard>

# ── OPTEX API ──────────────────────────────────────────────────────────────
# Production NestJS API base URL (no trailing /api)
NEXT_PUBLIC_API_URL=https://api.optexopticians.co.ke

# ── Contact form (Resend) ──────────────────────────────────────────────────
RESEND_API_KEY=re_<resend_api_key>
CONTACT_EMAIL=info@optexopticians.co.ke
