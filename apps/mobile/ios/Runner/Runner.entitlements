<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Without this entitlement APNs registration fails, so
	     Firebase Messaging never gets an APNs-backed token and no iOS device can
	     receive a push (SPEC-11 B-1). "development" is the value for debug and
	     profile builds; when Xcode signs an archive for TestFlight or the App
	     Store it takes the production value from the distribution provisioning
	     profile, so one file serves every configuration. The App ID must also
	     have the Push Notifications capability enabled in the Apple Developer
	     account, and an APNs key uploaded to Firebase. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
